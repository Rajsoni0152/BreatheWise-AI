# Root Environment Configuration Template for BreatheWise AI

# --- Backend Settings ---
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key
# 1. Sign in to https://aistudio.google.com/
# 2. Click "Get API key" -> "Create API key"
# 3. Paste key below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://breathewise-ai.vercel.app

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8000
