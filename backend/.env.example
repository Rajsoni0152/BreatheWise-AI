# Environment Variables for BreatheWise AI Backend
PORT=8000
HOST=0.0.0.0
# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: GEMINI_MODEL (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
# Optional CORS origins (comma-separated or * for development)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://breathewise-ai.vercel.app
